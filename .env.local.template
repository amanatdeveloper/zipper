# ---------------------------------------------------------------------------
# Runtime configuration (local `.env.local` / Cloudflare Worker secrets)
# For Cloudflare, set these with `npx wrangler secret put <NAME>`.
# ---------------------------------------------------------------------------

# Database (Neon Postgres)
# DATABASE_URL should point at the pooled endpoint (…-pooler.neon.tech).
# DIRECT_URL is only used by Prisma CLI commands (migrate/studio).
DATABASE_URL=
DIRECT_URL=

# NextAuth
# Production value must be the public app origin, e.g. https://app.example.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google Ads API (OAuth client shared by all stores)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Shopify (only needed if the Shopify integration is used)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADS_CALLBACK_URL=

# OpenAI (only needed for the AI page audit feature)
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Not read at runtime — only used by `npm run db:seed` to create the demo store.
# ---------------------------------------------------------------------------
WOO_URL=
WOO_CK=
WOO_CS=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_CUSTOMER_ID=
GOOGLE_LOGIN_CUSTOMER_ID=

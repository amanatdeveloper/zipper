// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  STORE_USER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole @default(STORE_USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]
}

model Store {
  id          String  @id @default(cuid())
  userId      String?
  name        String
  platform    String  @default("woocommerce")
  auditPrompt String  @default("Analyze this page for conversion optimization")

  // Google Ads credentials
  googleClientId        String
  googleClientSecret    String
  googleDeveloperToken  String
  googleRefreshToken    String
  googleCustomerId      String
  googleLoginCustomerId String

  // WooCommerce credentials
  wooUrl String
  wooCk  String
  wooCs  String

  // Shopify credentials
  shopifyShopDomain  String?
  shopifyAccessToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  optimizationLogs    OptimizationLog[]
  optimizationHistory OptimizationHistory[]
  pageAudits          PageAudit[]
  productMetas        ProductMeta[]

  @@index([userId])
}

model OptimizationLog {
  id          String   @id @default(uuid())
  sku         String
  storeId     String
  actionTaken String
  appliedAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, appliedAt])
  @@index([storeId, sku, appliedAt])
}

model PageAudit {
  id        String   @id @default(cuid())
  sku       String
  storeId   String
  url       String
  score     Int
  checklist Json
  summary   String   @db.Text
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, sku, createdAt])
  @@index([storeId, url, createdAt])
}

model ProductMeta {
  id             String   @id @default(cuid())
  sku            String
  normalizedSku  String
  storeId        String
  costPrice      Float    @default(0)
  leadTime       Int      @default(0)
  minSalesTarget Int      @default(0)
  isHidden       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, normalizedSku])
  @@index([storeId, sku])
}

model OptimizationHistory {
  id                String   @id @default(cuid())
  sku               String
  storeId           String
  optimizationNotes String   @db.Text
  acos              Float
  convRate          Float
  price             Float
  snapshotDate      DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, sku, snapshotDate])
  @@index([storeId, snapshotDate])
}

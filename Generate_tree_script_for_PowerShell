$exclude = @(".git",".next","node_modules",".vscode","dist","build","coverage",".vercel")

function Show-Tree {
    param(
        [string]$Path = ".",
        [string]$Prefix = ""
    )

    $items = Get-ChildItem -LiteralPath $Path -Force |
        Where-Object { $_.Name -notin $exclude } |
        Sort-Object @{Expression={$_.PSIsContainer};Descending=$true}, Name

    for($i = 0; $i -lt $items.Count; $i++){

        $item = $items[$i]

        if($i -eq $items.Count-1){
            $connector = "└── "
            $nextPrefix = $Prefix + "    "
        }
        else{
            $connector = "├── "
            $nextPrefix = $Prefix + "│   "
        }

        "$Prefix$connector$($item.Name)"

        if($item.PSIsContainer){
            Show-Tree $item.FullName $nextPrefix
        }
    }
}

$root = Split-Path (Get-Location) -Leaf

@(
    $root
    Show-Tree
) | Out-File structure.txt -Encoding utf8

Write-Host "Done."
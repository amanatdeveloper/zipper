
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zipper",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXTAUTH_URL": "https://scalefire.io",
    "GOOGLE_CLIENT_ID": "315755188339-qas3r4ls0dkdu6aino0l3tdrp2gm7fdi.apps.googleusercontent.com"
  }
}
